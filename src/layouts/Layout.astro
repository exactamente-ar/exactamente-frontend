---
import '@fontsource-variable/rubik';
import '@/core/global.css';
import GoogleAnalytics from '@/shared/components/GoogleAnalytics.astro';
import Footer from '@/shared/components/Footer.astro';
import ContainerPage from '@/shared/components/ContainerPage.astro';
import Header from '@/shared/components/Header.astro';
import SupportBanner from '@/shared/components/SupportBanner.astro';
import { FACULTY_SLUGS, DEFAULT_FACULTY_SLUG } from '@/core/theme/facultyPalettes';
import { STORED_FACULTY_KEY } from '@/features/home/utils/storedFaculty';

interface Props {
  hideFooterSponsor?: boolean;
}
const { hideFooterSponsor = false } = Astro.props;
---

<!doctype html>
<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/png' href='/logo.png' />
    <meta name='generator' content={Astro.generator} />
    <meta name='google-site-verification' content='W4j-waCOcYtizIRcI-3fHGekR9CnUWYutunME4biXhc' />
    <GoogleAnalytics />

    <!-- Aplica el tema de la facultad guardada antes de pintar, para evitar el flash del tema por defecto. -->
    <script
      is:inline
      define:vars={{
        storageKey: STORED_FACULTY_KEY,
        slugs: FACULTY_SLUGS,
        fallback: DEFAULT_FACULTY_SLUG,
      }}
    >
      let slug = fallback;
      try {
        const stored = JSON.parse(localStorage.getItem(storageKey) || 'null');
        if (stored && slugs.indexOf(stored.slug) !== -1) slug = stored.slug;
      } catch {
        // localStorage no disponible: se queda el tema por defecto.
      }
      document.documentElement.dataset.faculty = slug;
    </script>
    <title>Exactamente</title>
  </head>
  <body class='font-rubik bg-primary-foreground relative scroll-smooth'>
    <div class='fixed inset-0 bg-noise opacity-10 -z-0'></div>
    <div class='fixed inset-0 bg-black/70 -z-20'></div>
    <!-- <div class='absolute w-full h-screen top-0 -z-30'>
      <Aurora
        client:visible
        colorStops={["#3A29FF", "#FF94B4", "#FF3232"]}
        blend={0.5}
        amplitude={1.0}
        speed={0.5}
      />
    </div> -->
    <div class='absolute w-full h-screen md:h-[50vh] bottom-0 -z-30'>
      <div
        class='absolute -top-96 md:-top-32 w-full h-96 md:h-32 bg-gradient-to-b from-transparent to-primary-foreground'
      >
      </div>
      <div
        class='absolute top-0 w-full h-96 md:h-32 bg-gradient-to-b to-transparent from-primary-foreground'
      >
      </div>
    </div>
    <Header />
    <ContainerPage>
      <slot />
    </ContainerPage>
    <Footer hideSponsor={hideFooterSponsor} />
    <SupportBanner />
  </body>
</html>
