---
import '@fontsource-variable/rubik';
import '@/core/global.css';
import GoogleAnalytics from '@/shared/components/GoogleAnalytics.astro';
import Footer from '@/shared/components/Footer.astro';
import ContainerPage from '@/shared/components/ContainerPage.astro';
import Header from '@/shared/components/Header.astro';
import SupportBanner from '@/shared/components/SupportBanner.astro';
import { SITE_NAME, toAbsoluteUrl } from '@/shared/constants/site';
import { isStudyModeEnabled } from '@/features/study/flag';
import {
  STUDY_CONTEXT_ID,
  serializeStudyContext,
  type PageStudyContext,
} from '@/features/study/context';

interface Props {
  title?: string;
  description?: string;
  hideFooterSponsor?: boolean;
  /** URL canónica absoluta. Por defecto, el origen de producción + el path actual. */
  canonical?: string;
  /** Imagen para Open Graph. Si es relativa se resuelve sobre el origen de producción. */
  ogImage?: string;
  /** Materia de la página, para el Modo Estudio. Solo se emite con el flag prendido. */
  studyContext?: PageStudyContext;
}

const DEFAULT_DESCRIPTION =
  'Encontrá y compartí resúmenes, parciales y finales de tu carrera universitaria, organizados por materia.';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  hideFooterSponsor = false,
  canonical,
  ogImage = '/logo.png',
  studyContext,
} = Astro.props;

const studyMode = isStudyModeEnabled();
const studyContextJson = studyMode && studyContext ? serializeStudyContext(studyContext) : null;

const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
// Sin query string: los parámetros de navegación (`?home=`) no cambian el contenido.
const canonicalUrl = canonical ?? toAbsoluteUrl(Astro.url.pathname);
const ogImageUrl = toAbsoluteUrl(ogImage);
---

<!doctype html>
<html lang='es' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/png' href='/logo.png' />
    <meta name='generator' content={Astro.generator} />
    <meta name='google-site-verification' content='W4j-waCOcYtizIRcI-3fHGekR9CnUWYutunME4biXhc' />
    <GoogleAnalytics />

    <title>{fullTitle}</title>
    <meta name='description' content={description} />
    <link rel='canonical' href={canonicalUrl} />

    <meta property='og:title' content={fullTitle} />
    <meta property='og:description' content={description} />
    <meta property='og:url' content={canonicalUrl} />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content={SITE_NAME} />
    <meta property='og:locale' content='es_AR' />
    <meta property='og:image' content={ogImageUrl} />
    <meta name='twitter:card' content='summary' />
    <slot name='head' />
    {
      studyContextJson && (
        <script
          is:inline
          type='application/json'
          id={STUDY_CONTEXT_ID}
          set:html={studyContextJson}
        />
      )
    }
  </head>
  <body class='font-rubik bg-primary-foreground relative scroll-smooth'>
    <div class='fixed inset-0 bg-noise opacity-10 -z-0'></div>
    <div class='fixed inset-0 bg-black/70 -z-20'></div>
    <!-- <div class='absolute w-full h-screen top-0 -z-30'>
      <Aurora
        client:visible
        colorStops={["#3A29FF", "#FF94B4", "#FF3232"]}
        blend={0.5}
        amplitude={1.0}
        speed={0.5}
      />
    </div> -->
    <div class='absolute w-full h-screen md:h-[50vh] bottom-0 -z-30'>
      <div
        class='absolute -top-96 md:-top-32 w-full h-96 md:h-32 bg-gradient-to-b from-transparent to-primary-foreground'
      >
      </div>
      <div
        class='absolute top-0 w-full h-96 md:h-32 bg-gradient-to-b to-transparent from-primary-foreground'
      >
      </div>
    </div>
    <Header />
    <ContainerPage>
      <slot />
    </ContainerPage>
    <Footer hideSponsor={hideFooterSponsor} />
    <SupportBanner />
  </body>
</html>
