{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "env.d.ts", "src", "*.config.ts", "*.config.mjs"],
  "exclude": ["dist", "node_modules", ".claude", "_bmad"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"]
    }
  }
}
